{
  "permissions": {
    "allow": ["Bash(python3 -m pytest *)"],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  },
  "hooks": {
    "PreToolUse": [{
      "matcher": "Bash",
      "hooks": [{
        "type": "command",
        "if": "Bash(git commit *)",
        "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
      }]
    }]
  }
}
